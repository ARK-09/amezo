# AWS SDK v2's default credential chain (see config/S3Config.java) reads
# these directly from the environment - Spring Boot doesn't wire them, so
# there's nothing for them in application.yml. Only needed for testing
# image upload (POST /products/{id}/images/upload-url) against real S3;
# everything else (Postgres, magic-link auth, orders) works without them.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# Optional - only if using temporary/STS creds instead of a long-lived IAM user key
AWS_SESSION_TOKEN=

# App-level placeholder (application.yml's app.s3.bucket) - must actually
# exist and be writable by the credentials above.
AWS_S3_BUCKET=amezo-dev
