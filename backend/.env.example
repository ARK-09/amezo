# AWS SDK v2's default credential chain (see config/S3Config.java) reads these
# directly from the environment - Spring Boot doesn't wire them, so there's
# nothing for them in application.yml. Only needed for image upload
# (POST /products/{id}/images/upload-url and the browser's PUT to the presigned
# URL); everything else (Postgres, magic-link auth, orders) works without them.
#
# These are S3 *API* credentials, not necessarily AWS ones - any S3-compatible
# provider issues the same pair. See docs/deploy.md for why the deployed setup
# uses Cloudflare R2 (10 GB free, no egress charges) rather than AWS S3, whose
# free tier expires after 12 months.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS: a real region (us-east-1). R2: literally "auto".
AWS_REGION=us-east-1

# Optional - only if using temporary/STS creds instead of a long-lived IAM user key
AWS_SESSION_TOKEN=

# App-level placeholder (application.yml's app.s3.bucket) - must actually
# exist and be writable by the credentials above.
AWS_S3_BUCKET=amezo-dev

# Unset = real AWS S3. Set = S3-compatible provider, which also switches the
# client to path-style addressing (config/S3Config.java).
#   R2:    https://<cloudflare-account-id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_ENDPOINT=

# Where a browser loads the stored images from - a different host than the API
# endpoint above on every non-AWS provider. Unset = the AWS virtual-hosted URL
# built from bucket + region.
#   R2: https://pub-<hash>.r2.dev (enable public access on the bucket), or your
#       own domain routed to the bucket
S3_PUBLIC_BASE_URL=
