# Every environment variable the backend reads. All of them have a default in
# application.yml that points at a local dev setup, so an empty environment
# still runs locally - the ones marked REQUIRED IN PROD are the ones whose
# default is wrong anywhere but a laptop.
#
# Deployed, these are set in the host's dashboard, not in a file (see
# docs/deploy.md and render.yaml). Copy to backend/.env for local overrides.


# ── HTTP ──────────────────────────────────────────────────────────────────────
# Container hosts inject the port they route to and don't let you pick it.
PORT=8080


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED IN PROD. Must be a JDBC URL - not the postgres://user:pass@host/db
# URI most providers show you. Credentials go in the two vars below, because
# Spring's datasource URL parser doesn't read them out of the URI.
#   Neon: jdbc:postgresql://<host>/<db>?sslmode=require
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/marketplace
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root

# Hikari pool ceiling. Free Postgres plans cap connections hard and one small
# JVM has no use for the default 10.
DATABASE_POOL_SIZE=5

# Flyway applies db/migration on boot - that's what creates the schema on a
# fresh hosted database. Only set false when something else owns migrations
# (a shared database, a read replica).
FLYWAY_ENABLED=true


# ── Frontend / CORS ───────────────────────────────────────────────────────────
# REQUIRED IN PROD, both of them.
# Where magic-link emails point (SellerAuthService builds /seller/verify?token=
# on top of this).
APP_FRONTEND_URL=http://localhost:5173

# Exact browser origins allowed to call the API, comma-separated, no trailing
# slash and no wildcard: credentials are allowed, so a wildcard is rejected
# outright. Add each Vercel preview origin you want to test against.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://amezo-frontend.localhost


# ── Session cookie ────────────────────────────────────────────────────────────
# REQUIRED IN PROD: SameSite=None + Secure=true. With the frontend on one domain
# and the API on another, every call is cross-site and a Lax cookie is never
# sent back - sign-in appears to work and the next call 401s. Browsers also
# reject SameSite=None unless Secure is set, so the two move together.
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_SESSION_COOKIE_SECURE=false

APP_SESSION_COOKIE_NAME=mp_session
APP_SESSION_TTL_DAYS=30

# How long a magic link stays redeemable.
APP_MAGIC_LINK_TTL_MINUTES=15


# ── Object storage (image upload only) ────────────────────────────────────────
# Needed for POST /products/{id}/images/upload-url and the browser's PUT to the
# presigned URL. Everything else - catalog, auth, cart, checkout, orders - runs
# without any of it. docs/deploy.md explains why the deployed setup uses
# Cloudflare R2 rather than AWS S3 (10 GB free, no egress charge, no expiry).
#
# S3 *API* credentials, read straight from the environment by the AWS SDK's
# default chain (config/S3Config.java wires nothing) - any S3-compatible
# provider issues the same pair.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional - only for temporary/STS credentials instead of a long-lived key.
AWS_SESSION_TOKEN=

# Must exist and be writable by the credentials above.
AWS_S3_BUCKET=amezo-dev

# AWS: a real region. R2: literally "auto".
AWS_REGION=us-east-1

# Empty = real AWS S3. Set = S3-compatible provider, which also switches the
# client to path-style addressing.
#   R2:    https://<cloudflare-account-id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_ENDPOINT=

# Storage budget, and the reason it exists: object storage bills per GB and the
# free tiers stop being free past their allowance, so past the total the upload
# endpoint answers 507 instead of issuing more presigned URLs. The total counts
# stored objects plus presigned URLs that haven't expired, so a burst of parallel
# requests can't collectively overshoot. Defaults: 10 GiB total, 10 MiB per file.
S3_MAX_TOTAL_BYTES=10737418240
S3_MAX_UPLOAD_BYTES=10485760

# Where a browser loads stored images from - a different host than the API
# endpoint above on every non-AWS provider. Empty = the AWS virtual-hosted URL
# built from bucket + region.
#   R2: https://pub-<hash>.r2.dev (needs public access enabled on the bucket),
#       or your own domain in front of it
S3_PUBLIC_BASE_URL=


# ── Logging and docs ──────────────────────────────────────────────────────────
# Set warn in prod: debug logs every statement, and free tiers meter logs.
SQL_LOG_LEVEL=debug

# Pretty-printed SQL is for reading by hand; set false in prod.
HIBERNATE_FORMAT_SQL=true

# The OpenAPI spec is served publicly at API_DOCS_PATH (SecurityConfig follows
# this property, so moving the path moves the allow-list with it). Disabling it
# means the deploy guide's boot probe needs to be some other endpoint.
API_DOCS_ENABLED=true
API_DOCS_PATH=/v3/api-docs


# Anything under spring.* is additionally overridable with Spring Boot's own
# SPRING_* names without appearing here - SPRING_JPA_HIBERNATE_DDL_AUTO,
# SPRING_APPLICATION_NAME and so on. Two values are left hardcoded on purpose,
# because they are facts about the artifact rather than the environment, and an
# env override would only let a deploy break itself: spring.jpa.hibernate
# .ddl-auto=validate (Flyway owns the schema, Hibernate only checks it matches)
# and spring.flyway.locations (the migrations ship inside the jar).
