VITE_API_URL=http://localhost:8080

# Mock the API in the browser dev server via MSW (src/test/msw/handlers.ts),
# instead of hitting the real backend. Turn off once GET /products supports
# category/price/stock/sort and the database has seed data - see
# openapi/fixture.yaml's note, same swap point. GET /variants (cart batch
# fetch) and GET /products/{productId} (product detail) aren't implemented
# either, so turning this off before all three are ready will break the
# cart and detail page, not just search filters.
VITE_USE_MSW=true
