# Production build (Vercel). The backend is live at the URL below, so this build
# talks to it instead of mocking - the MSW-in-production shim that stood in for a
# missing backend is gone.
VITE_API_URL=https://amezo.onrender.com

# Real API, not the browser mock. Requires the backend endpoints the app calls to
# exist for real: GET /products (with category/price/stock filters and sort),
# GET /products/{id}, GET /variants?ids= (the cart's batch lookup), POST /orders,
# and the seller portal's own set. All present as of the catalog pass that came
# with this switch.
VITE_USE_MSW=false

# Real magic-link sign-in. It cannot be `true` against a live backend: the bypass
# fakes a client-side session without the mp_session cookie the API authenticates
# with, so the portal would load and then 401 on every request.
#
# Cost of `false`, worth knowing before you demo it: LoggingEmailSender only
# writes the sign-in link to the server log, so signing in means copying the
# token out of Render's log stream. Wiring a real email sender (Resend, Brevo -
# both have free tiers) is what makes this a normal sign-in.
VITE_DEMO_SELLER_AUTH=false

# Cold start: the free Render instance sleeps after 15 minutes idle, so the first
# request after a quiet spell waits ~1 minute while it wakes. Nothing in the
# frontend papers over that - see docs/deploy.md.
