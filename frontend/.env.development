# Dev-only (Vite loads this for `vite`/`npm run dev`, mode "development" -
# vitest runs in mode "test" and never reads it, so SellerSignIn.test.tsx's
# real-flow coverage stays intact). Same bypass as .env.production - see
# SellerSignIn.tsx - so `npm run dev` matches the deployed demo instead of
# needing a real email round trip locally too.
VITE_DEMO_SELLER_AUTH=true
